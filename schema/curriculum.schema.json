{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shintajiri/Curriculum-as-Code/schema/curriculum.schema.json",
  "title": "Curriculum as Code",
  "description": "Source of truth for a degree programme's curriculum: programme learning outcomes (DP) defined once, courses referencing them by ID.",
  "type": "object",
  "required": ["dp_definitions", "courses"],
  "additionalProperties": false,
  "properties": {
    "programme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string", "description": "Version label of this source; stamped into generated documents."},
        "dp_levels": {
          "type": "array", "items": {"type": "string"}, "minItems": 1,
          "description": "Allowed level words for courses[].dp values (e.g. 導入 / 展開 / 発展)."
        }
      }
    },
    "dp_definitions": {
      "type": "object",
      "description": "Programme learning outcomes (DP): ID -> name (string) or {name, description}.",
      "minProperties": 1,
      "propertyNames": {"pattern": "^DP[0-9]+$"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "object", "required": ["name"], "additionalProperties": false,
           "properties": {"name": {"type": "string"}, "description": {"type": "string"}}}
        ]
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "goals", "dp", "assessments"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "year": {"type": "integer", "minimum": 1},
          "term": {"type": "string"},
          "credits": {"type": "number", "minimum": 0},
          "goals": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"pattern": "^G[0-9]+$"},
            "additionalProperties": {"type": "string", "minLength": 1},
            "description": "Learning goals of the course: ID (G1, G2 ...) -> statement."
          },
          "dp": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"pattern": "^DP[0-9]+$"},
            "additionalProperties": {"type": "string"},
            "description": "DP referenced by ID -> level word (must be one of programme.dp_levels when given)."
          },
          "assessments": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["method", "weight", "goals"],
              "additionalProperties": false,
              "properties": {
                "method": {"type": "string", "minLength": 1},
                "weight": {"type": "number", "minimum": 0, "maximum": 100, "description": "Share of the course grade in percent."},
                "goals": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^G[0-9]+$"},
                          "description": "Learning goal IDs this assessment measures."}
              }
            }
          }
        }
      }
    }
  }
}
